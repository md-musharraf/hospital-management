# Copied to .env automatically on first `npm run dev` (with a random DEMO_PASSWORD).
PORT=3000
# Public URL used in WhatsApp links (track token, receipts)
PUBLIC_URL=http://localhost:3000
# Hospital timezone for "today" (daily income, queue tokens)
HOSPITAL_TZ=Asia/Kolkata
# Seed demo doctors, staff, patients and 14 days of bills. Staff usernames: owner, reception, doctor, lab, pharmacy
SEED_DEMO=true
DEMO_PASSWORD=
# Production first run: owner account password (username "owner")
OWNER_PASSWORD=
# WhatsApp Cloud API (Meta). Empty = messages are only logged in Settings → WhatsApp.
WA_TOKEN=
WA_PHONE_NUMBER_ID=
WA_VERIFY_TOKEN=
WA_APP_SECRET=
# Approved "authentication" template for patient login OTP (needed outside the 24h chat window)
WA_OTP_TEMPLATE=
