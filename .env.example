# ===== CarePoint HMS settings =====
# Local: copied to .env automatically on the first `npm run dev` (with a random demo password).
# Render: add the keys you need under your service → Environment. Vercel needs none of these.

# --- Server ---
PORT=3000
# Interface to listen on. Empty = 0.0.0.0 (all; needed for Docker / Render)
HOST=
# Website address used in WhatsApp links (track token, receipts). On Render: your Vercel URL
PUBLIC_URL=http://localhost:3000
# Hospital timezone for "today" (daily income, queue tokens)
HOSPITAL_TZ=Asia/Kolkata
# Which proxies to trust for the visitor IP (rate limits). Render behind Vercel: true. Empty = safe default
TRUST_PROXY=

# --- Data ---
# Folder for hospital.db. Paid Render with a disk: /data. Empty = ./.data
DATA_DIR=
# Full path to the database file (overrides DATA_DIR; rarely needed)
DB_PATH=
# Free hosting without a disk (client trial): MongoDB URI, e.g. Atlas M0 .../carepoint?retryWrites=true&w=majority
# The database is saved there 30 s after changes and on shutdown, and restored on an empty disk.
# Next to a paid disk it acts as an off-site backup. Empty = off
MONGODB_URI=

# --- Accounts: used only on the very first start, when the database is empty ---
# true = demo doctors, staff (owner, reception, doctor, lab, pharmacy), patients and 14 days of bills
SEED_DEMO=true
# Password for every demo staff account. Always set it in production (otherwise a well-known default is used)
DEMO_PASSWORD=
# With SEED_DEMO=false: password of the "owner" account (8+ characters)
OWNER_PASSWORD=

# --- WhatsApp Cloud API (Meta). Empty = messages are only logged in Settings → WhatsApp ---
WA_TOKEN=
WA_PHONE_NUMBER_ID=
WA_VERIFY_TOKEN=
WA_APP_SECRET=
# Approved "authentication" template for patient login OTP (needed outside the 24h chat window)
WA_OTP_TEMPLATE=
